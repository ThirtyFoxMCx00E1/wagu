<?xml version="1.0" encoding="utf-8"?>
<!-- MP Voice (3.11.1): gives MP's voice chat a microphone when the GTA SA APK has no
     RECORD_AUDIO permission. Records 48 kHz mono and passes it to the game over 127.0.0.1 only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thirtyfox.mpvoice"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="MP Voice" android:icon="@drawable/icon" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".MicService" android:exported="false" android:foregroundServiceType="microphone" />
    </application>
</manifest>
