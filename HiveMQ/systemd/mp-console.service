# MP web console (ttyd): the server menu in the browser, protected by a password (+ TLS with a domain)
[Unit]
Description=MP Multiplayer web console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@@BASE@@/console/ttyd -p 7681 @@BIND@@ -c @@CRED@@ -W -m 3 -t titleFixed=MP-Console -t fontSize=15 @@SSL@@ @@BASE@@/console/mp-console.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
