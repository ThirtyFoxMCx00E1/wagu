# The region's 24/7 default server "MP LAN Server" (installed by install.sh)
[Unit]
Description=MP Multiplayer default server (@@REGION@@)
After=hivemq.service network-online.target
Wants=hivemq.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mp
Group=mp
WorkingDirectory=@@BASE@@/server
ExecStart=@@BASE@@/server/mp_server @@PORT@@ "@@NAME@@" @@MAX@@ @@REGION@@ --persistent --broker-file @@BASE@@/server/broker.txt
Restart=always
# 3.33: back within 2 s after a crash, and never give up (the 4 servers stay online 24/7)
RestartSec=2
LimitNOFILE=65536
Nice=-10
# 3.37 VPS: the game gets the CPU first (bots, apt, logs wait), last to be killed when RAM runs out
CPUWeight=1000
IOWeight=1000
OOMScoreAdjust=-900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
