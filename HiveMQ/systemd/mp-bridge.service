# MpBridge: joins the server lists of all regional brokers (install.sh --bridge: on ONE server only)
# 3.38: also runs on every VPS as the public mirror (its 24/7 servers listed in the public lobby)
[Unit]
Description=MP Multiplayer lobby bridge
After=hivemq.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mp
Group=mp
WorkingDirectory=@@BASE@@/bridge
ExecStart=@@JAVA_HOME@@/bin/java -Xms32m -Xmx128m -XX:+UseSerialGC @@BASE@@/bridge/MpBridge.java @@ETC@@/bridge.conf
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
