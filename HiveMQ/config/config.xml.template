<?xml version="1.0"?>
<!--
  HiveMQ Community Edition config for the MP Multiplayer mod (one regional broker).
  Generated by install.sh - edit config/config.xml.template in the repo, not this copy.
  Ports:  1883 MQTT (the mod)   8000 MQTT over WebSocket (fallback for networks that block 1883)
          8883 MQTT + TLS       8884 WebSocket + TLS (the website, needs a domain)   - only with DOMAIN=
-->
<hivemq xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="config.xsd">

    <listeners>
        <tcp-listener>
            <port>1883</port>
            <bind-address>0.0.0.0</bind-address>
            <name>mqtt</name>
        </tcp-listener>
        <websocket-listener>
            <port>8000</port>
            <bind-address>0.0.0.0</bind-address>
            <path>/mqtt</path>
            <name>ws</name>
            <subprotocols>
                <subprotocol>mqttv3.1</subprotocol>
                <subprotocol>mqtt</subprotocol>
            </subprotocols>
            <allow-extensions>true</allow-extensions>
        </websocket-listener>
@@TLS_LISTENERS@@
    </listeners>

    <mqtt>
        <!-- the relay is real-time: never pile up old positions for slow clients -->
        <queued-messages>
            <!-- 3.37 VPS: 64 (was 200): a slow phone gets the newest state, not seconds of old positions -->
            <max-queue-size>64</max-queue-size>
            <strategy>discard-oldest</strategy>
        </queued-messages>
        <session-expiry>
            <!-- 3.37 VPS: 120 s (was 300): a phone that left frees its session (subscriptions + queue) sooner.
                 Reconnects within 2 minutes still resume. Keeps the broker light with 100s of players coming and going -->
            <max-interval>120</max-interval>
        </session-expiry>
        <message-expiry>
            <!-- 3.37 VPS: 600 s (was 3600): stale retained / queued data is cleared from RAM by the broker itself -->
            <max-interval>600</max-interval>
        </message-expiry>
        <keep-alive>
            <allow-unlimited>false</allow-unlimited>
            <!-- 3.37 VPS: 60 (was 120): a dead phone is noticed in ~90 s instead of 3 min -->
            <max-keep-alive>60</max-keep-alive>
        </keep-alive>
        <packets>
            <max-packet-size>65536</max-packet-size>  <!-- game batches are < 8 KB -->
        </packets>
        <receive-maximum>
            <server-receive-maximum>100</server-receive-maximum>
        </receive-maximum>
        <quality-of-service>
            <max-qos>1</max-qos>
        </quality-of-service>
        <wildcard-subscriptions>
            <enabled>true</enabled>
        </wildcard-subscriptions>
        <shared-subscriptions>
            <enabled>false</enabled>
        </shared-subscriptions>
        <retained-messages>
            <enabled>true</enabled>
        </retained-messages>
    </mqtt>

    <restrictions>
        <max-connections>@@MAX_CONNECTIONS@@</max-connections>
        <max-client-id-length>64</max-client-id-length>
        <max-topic-length>128</max-topic-length>
        <!-- drop sockets that open but never log in (port scanners, floods) -->
        <no-connect-idle-timeout>5000</no-connect-idle-timeout>
        <!-- per client, bytes/second. 3.33: default 4 MB/s (was 512 KB/s: a busy relay host hit the limit and every player's ping went up). 0 = unlimited -->
        <incoming-bandwidth-throttling>@@BANDWIDTH@@</incoming-bandwidth-throttling>
    </restrictions>

    <security>
        <allow-empty-client-id>
            <enabled>false</enabled>
        </allow-empty-client-id>
        <utf8-validation>
            <enabled>true</enabled>
        </utf8-validation>
    </security>

    <!-- everything in RAM: lowest latency. Retained server listings come back within 3 s after a restart -->
    <persistence>
        <mode>in-memory</mode>
    </persistence>

    <anonymous-usage-statistics>
        <enabled>false</enabled>
    </anonymous-usage-statistics>

</hivemq>
