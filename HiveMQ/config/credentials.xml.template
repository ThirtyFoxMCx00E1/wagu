<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Logins + topic rules (HiveMQ File RBAC extension). Generated by install.sh.
  Passwords are stored hashed. Re-run install.sh (or tools/add-user.sh) to change them.

  mp      - the mod and mp_server (this login ships inside the mod / regions.txt, so it is not
            secret: the rules below are what keep it safe). 3.04.6: full access on thirtyfox/mp5/ (MP
            3.04.6+), read-only + join-only on the old thirtyfox/mp4/ (old versions can't host)
  web     - the website's live server list: read-only, server list only
  bridge  - MpBridge (copies server lists between regions) + mp-status beacon. Keep this password secret.
  One login for 100+ phones is fine: every phone connects with its own random client id
  (tfmpXXXXXXXXXXXX), and the rules use ${{clientid}}, so phones never read or kick each other.
  admin   - everything (debugging only). Keep this password secret.
-->
<file-rbac>
    <users>
        <user>
            <name>@@MP_USER@@</name>
            <password>@@MP_HASH@@</password>
            <roles><id>mp</id></roles>
        </user>
        <user>
            <name>@@WEB_USER@@</name>
            <password>@@WEB_HASH@@</password>
            <roles><id>web</id></roles>
        </user>
        <user>
            <name>bridge</name>
            <password>@@BRIDGE_HASH@@</password>
            <roles><id>bridge</id></roles>
        </user>
        <user>
            <name>admin</name>
            <password>@@ADMIN_HASH@@</password>
            <roles><id>superuser</id></roles>
        </user>
    </users>
    <roles>
        <role>
            <id>mp</id>
            <permissions>
                <!-- MP 3.04.6+: thirtyfox/mp5/ (the lobby moved there) -->
                <!-- server list: hosts announce, everyone reads -->
                <permission><topic>thirtyfox/mp5/l/+</topic></permission>
                <!-- player -> host: a player may only send as himself -->
                <permission>
                    <topic>thirtyfox/mp5/s/+/${{clientid}}</topic>
                    <activity>PUBLISH</activity>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <!-- host: receives from all its players -->
                <permission>
                    <topic>thirtyfox/mp5/s/+/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <!-- host -> player: anyone may send, but only the player himself can read his inbox -->
                <permission>
                    <topic>thirtyfox/mp5/c/+</topic>
                    <activity>PUBLISH</activity>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <permission>
                    <topic>thirtyfox/mp5/c/${{clientid}}</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <!-- shared updates (host -> all its players) -->
                <permission>
                    <topic>thirtyfox/mp5/b/+</topic>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <!-- region health (read only) -->
                <permission>
                    <topic>thirtyfox/mp4/st/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <!-- MP 3.04.5 and older (thirtyfox/mp4/, they let players cheat): READ the list (they only
                     see the "UPDATE MP" notice server), send a join to it and read its answer.
                     They can NOT host (no publish on mp4/l), so old phones can't play on these brokers. -->
                <permission>
                    <topic>thirtyfox/mp4/l/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>thirtyfox/mp4/s/+/${{clientid}}</topic>
                    <activity>PUBLISH</activity>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <permission>
                    <topic>thirtyfox/mp4/c/${{clientid}}</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>web</id>
            <permissions>
                <permission>
                    <topic>thirtyfox/mp5/l/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>thirtyfox/mp4/st/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <!-- 2.22: autopilot reports (read only, shown by MP Bot in Termius) -->
                <permission>
                    <topic>thirtyfox/mp4/bot/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>bridge</id>
            <permissions>
                <permission><topic>thirtyfox/mp4/l/#</topic></permission>
                <permission><topic>thirtyfox/mp5/l/#</topic></permission>
                <!-- 3.04.6: the "UPDATE MP" notice server (mp-legacy) hosts in the old lobby with this login -->
                <permission><topic>thirtyfox/mp4/s/#</topic><activity>SUBSCRIBE</activity></permission>
                <permission><topic>thirtyfox/mp4/c/+</topic><activity>PUBLISH</activity><retain>NOT_RETAINED</retain></permission>
                <permission><topic>thirtyfox/mp4/b/+</topic><retain>NOT_RETAINED</retain></permission>
                <!-- 3.34: game branch - MpBridge carries game frames between regions (phones stay on the nearest one) -->
                <permission><topic>thirtyfox/mp5/s/#</topic><retain>NOT_RETAINED</retain></permission>
                <permission><topic>thirtyfox/mp5/c/+</topic><retain>NOT_RETAINED</retain></permission>
                <permission><topic>thirtyfox/mp5/b/+</topic><retain>NOT_RETAINED</retain></permission>
                <!-- 2.21: region status beacon (mp-status) -->
                <permission><topic>thirtyfox/mp4/st/#</topic></permission>
                <!-- 2.22: autopilot reports (mp-status) -->
                <permission><topic>thirtyfox/mp4/bot/#</topic></permission>
            </permissions>
        </role>
        <role>
            <id>superuser</id>
            <permissions>
                <permission><topic>#</topic></permission>
            </permissions>
        </role>
    </roles>
</file-rbac>
