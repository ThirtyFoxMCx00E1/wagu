<?xml version="1.0" encoding="utf-8"?>
<!-- MP Textdraw Editor (3.50): the /tde textdraw editor as an app. Landscape, MP account login,
     saves ONE .mptd file per project (also copied to Download/MP Textdraws) for MP Launcher >
     Add server > Plugins > Textdraw. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thirtyfox.mptde"
    android:versionCode="4053"
    android:versionName="4.05.3">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <application android:label="MP Textdraw Editor" android:icon="@drawable/icon" android:allowBackup="false"
        android:hardwareAccelerated="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
