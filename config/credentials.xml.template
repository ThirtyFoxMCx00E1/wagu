<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Logins + topic rules (HiveMQ File RBAC extension). Generated by install.sh.
  Passwords are stored hashed. Re-run install.sh (or tools/add-user.sh) to change them.

  mp      - the mod and mp_server (this login ships inside the mod / regions.txt, so it is not
            secret: the rules below are what keep it safe)
  web     - the website's live server list: read-only, server list only
  bridge  - MpBridge (copies server lists between regions). Keep this password secret.
  admin   - everything (debugging only). Keep this password secret.
-->
<file-rbac>
    <users>
        <user>
            <name>@@MP_USER@@</name>
            <password>@@MP_HASH@@</password>
            <roles><id>mp</id></roles>
        </user>
        <user>
            <name>@@WEB_USER@@</name>
            <password>@@WEB_HASH@@</password>
            <roles><id>web</id></roles>
        </user>
        <user>
            <name>bridge</name>
            <password>@@BRIDGE_HASH@@</password>
            <roles><id>bridge</id></roles>
        </user>
        <user>
            <name>admin</name>
            <password>@@ADMIN_HASH@@</password>
            <roles><id>superuser</id></roles>
        </user>
    </users>
    <roles>
        <role>
            <id>mp</id>
            <permissions>
                <!-- server list: hosts announce, everyone reads -->
                <permission><topic>thirtyfox/mp4/l/+</topic></permission>
                <!-- player -> host: a player may only send as himself -->
                <permission>
                    <topic>thirtyfox/mp4/s/+/${{clientid}}</topic>
                    <activity>PUBLISH</activity>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <!-- host: receives from all its players -->
                <permission>
                    <topic>thirtyfox/mp4/s/+/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <!-- host -> player: anyone may send, but only the player himself can read his inbox -->
                <permission>
                    <topic>thirtyfox/mp4/c/+</topic>
                    <activity>PUBLISH</activity>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <permission>
                    <topic>thirtyfox/mp4/c/${{clientid}}</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <!-- shared updates (host -> all its players) -->
                <permission>
                    <topic>thirtyfox/mp4/b/+</topic>
                    <retain>NOT_RETAINED</retain>
                </permission>
            </permissions>
        </role>
        <role>
            <id>web</id>
            <permissions>
                <permission>
                    <topic>thirtyfox/mp4/l/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>bridge</id>
            <permissions>
                <permission><topic>thirtyfox/mp4/l/#</topic></permission>
            </permissions>
        </role>
        <role>
            <id>superuser</id>
            <permissions>
                <permission><topic>#</topic></permission>
            </permissions>
        </role>
    </roles>
</file-rbac>
